2 line segments
XO=[0;10];XM=[5;0];XE=[20;-5];
for lamda=0:0.05:1
x=(1-lamda)*XO + lamda*XM;
plot(x(1,1),x(2,1),'b.','MarkerSize',18)
%plots a single point
pause(0.1)
hold on
axis('equal')
plot([0 20],[0 0])
plot([0,0],[-5,10])
drawnow
end
for lamda=0:0.05:1
    x=(1-lamda)*XE + lamda*XM;
    plot(x(1,1),x(2,1),'b.','MarkerSize',18)
pause(0.1)
hold on
