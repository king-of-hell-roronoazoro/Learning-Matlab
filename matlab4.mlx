vertical scale
syms f(x)
3
f(x) = x.^2;
figure
fplot(f(x), [-4 4], 'Color','y')
grid on
hold on
fplot((1/2)*f(x), [-4 4], 'Color','m')
hold on
fplot((2)*f(x), [-4 4], 'Color','b')
hold off
axis([-6 6 0 5])
axis equal;
title('Vertical scaling')
horizontal scale
syms f(x)
f(x)=x.^2;
figure
grid on
hold on
fplot(f(x), [-4 4],'Color','y')
fplot(f(x*2),[-4 4],'Color','r')
fplot(f(x/2),[-4 4],'Color','g')
hold off
title('horizontal scale')
4
animate AB
points on AB are x = (1-lamda)A + lamda*B
and lamda is from 0 to 1
A=[1;1];B=[4;5];
for lamda=0:0.05:1
x=(1-lamda)*A + lamda*B;
plot(x(1,1),x(2,1),'b.','MarkerSize',18)
%plots a single point
pause(0.1)
hold on
axis('equal')
plot([-1 5],[0 0])
plot([0,0],[-1,5])
drawnow
end
hold off
