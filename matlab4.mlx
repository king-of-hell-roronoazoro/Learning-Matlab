x=-5:0.01:1.5;
y=x.^2;
plot(x,y,'color','y')
grid on
hold on
pause(1)
%shifting 4 upward
y1=x.^2+4;
plot(x,y1,'color','r')
pause(1)
%shifting 4 downward
y2=x.^2-4;
plot(x,y2,'Color','g')
pause(1)
%shifting 1 right
y3=(x-1).^2;
plot(x,y3,'Color','b')
%hifting 2 left and 4 up
pause(1)
y4=(x+2).^2+4;
plot(x,y4,'Color','black')
%shifting 3 right and 5 down
pause(1)
y5=(x-3).^2-5;
plot(x,y5,'Color','m')
hold off
