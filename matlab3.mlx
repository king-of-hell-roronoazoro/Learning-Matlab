plot3(x,x,x.^2)

Q10
x=-100:0.1:100;
plot3(x,sin(x),x.^2)

Q11
t=-4*pi:0.01:4*pi;
plot3(5*cos(t),3*sin(t),t+1,'Color','blue')
hold on
plot3(cos(t),sin(t),t,'Color','red')
hold off

Q12
use & when you need two functions in one bracket
x=linspace(3,0,500);
y1=(x<=1).*(x);
y2=(x>1 & x<=2).*(1);
y3=(x>2 & x<=3).*(3-x);
y=y1+y2+y3;
plot(x,y)

Q13
x=linspace(-10,10,1000);
y1=(-10<=x & -1>=x).*(1);
y2=(-1<x & x<=1).*(-x);
y3=(1<=x & x<=10).*(x-2);
y=y1+y2+y3;
plot(x,y)

Q14
x=linspace(-3*pi/2,3*pi/2,10000);
y1=(-3/2*pi<=x & x<=0).*(sin(x));
y2=(0<x & x<=1/2*pi).*(2*x);
y3=(1/2*pi<x & x<=3/2*pi).*(pi-cos(x));
plot(x,y1+y2+y3);

